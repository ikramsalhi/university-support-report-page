# Create DATA_ENCRYPTION_KEY with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# DO NOT commit your real encryption key. Keep backups of it securely.
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=backend/data/tickets.sqlite
